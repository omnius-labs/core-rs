version 1;
package omnius::demo::v1;

// comment1
/* comment2 */

struct PrimitiveShowcase1 {
  @1 bool_field: bool;
  @2 u8_field: u8;
  @3 i16_field: i16;
  @4 i32_field: i32;
  @5 i64_field: i64;
  @6 u16_field: u16;
  @7 u32_field: u32;
  @8 u64_field: u64;
  @10 f32_field: f32;
  @11 f64_field: f64;
  @12 slice_field: [i64; 4];
  @13 struct_field: SimpleMessage;
  @14 string_field: string[1..=MAX_TEXT_LEN];
  @15 bytes_field: bytes[1..=MAX_SAMPLE_SIZE];
  @16 vec_field_1: Vec<u8>[1..=8];
  @17 vec_field_2: Vec<string[1..=16]>[1..=8];
  @18 vec_field_3: Vec<bytes[1..=8]>[1..=4];
  @19 map_field_1: Map<u8, string[1..=16]>[1..=4];
  @20 map_field_2: Map<string[1..=8], u8>[..=4];
  @21 map_vec_field_1: Map<string[1..=8], Vec<u32>[..=8]>[..=4];
  @22 map_vec_field_2: Map<string[1..=8], Vec<bytes[1..=8]>[..=4]>[..=4];
  @23 timestamp_64: Timestamp64;
  @24 timestamp_96: Timestamp96;
}

struct PrimitiveShowcase2 {
  @1 bool_field: Option<bool>;
  @2 u8_field: Option<u8>;
  @3 i16_field: Option<i16>;
  @4 i32_field: Option<i32>;
  @5 i64_field: Option<i64>;
  @6 u16_field: Option<u16>;
  @7 u32_field: Option<u32>;
  @8 u64_field: Option<u64>;
  @10 f32_field: Option<f32>;
  @11 f64_field: Option<f64>;
  @12 struct_field: Option<SimpleMessage>;
  @13 string_field: Option<string[1..=MAX_TEXT_LEN]>;
  @14 bytes_field: Option<bytes[1..=MAX_SAMPLE_SIZE]>;
  @15 vec_field_1: Option<Vec<u8>[1..=8]>;
  @16 vec_field_2: Option<Vec<string[1..=16]>[1..=8]>;
  @17 vec_field_3: Option<Vec<bytes[1..=8]>[1..=4]>;
  @18 map_field_1: Option<Map<u8, string[1..=16]>[1..=4]>;
  @19 map_field_2: Option<Map<string[1..=8], u8>[..=4]>;
  @20 map_vec_field_1: Option<Map<string[1..=8], Vec<u32>[..=8]>[..=4]>;
  @21 map_vec_field_2: Option<Map<string[1..=8], Vec<bytes[1..=8]>[..=4]>[..=4]>;
  @22 timestamp_64: Option<Timestamp64>;
  @23 timestamp_96: Option<Timestamp96>;
}

enum PrimitiveShowcase3 {
  @1 First;
  @2 Second(entity: string[1..=MAX_TEXT_LEN], payload: ByteList);
  @3 Third {
    @1 entity: string[1..=MAX_TEXT_LEN];
    @2 status: Status;
    @3 retries: u32 = 0;
    @4 struct_field: Option<SimpleMessage>;
  };
}

enum Status {
  @1 Success;
  @2 Failed;
}

struct SimpleMessage {
  @1 bool_field: Option<bool>;
}

struct NestedChild {
  @1 label: string[1..=4];
}

struct NestedParent {
  @1 child: NestedChild;
}

type ByteList = Vec<bytes[1..=8]>[1..=4];
const MAX_TEXT_LEN: u32 = 32;
const MAX_SAMPLE_SIZE: u32 = 1_048_576;
